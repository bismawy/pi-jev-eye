{
  "name": "@bismawy/pi-jev-eye",
  "version": "0.1.16",
  "type": "module",
  "description": "Ultra-lean supervisor. Three-layer guardrails. Semantic gate for Pi. Blocks destructive commands offline, checks tests, gates diffs through TypeSafe Jev.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "typesafe",
    "jev",
    "guardrail",
    "supervisor",
    "security"
  ],
  "author": "bismawy",
  "license": "MIT",
  "scripts": {
    "dev": "pi -e ./extensions/index.ts",
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bismawy/pi-jev-eye.git"
  },
  "homepage": "https://github.com/bismawy/pi-jev-eye#readme",
  "bugs": {
    "url": "https://github.com/bismawy/pi-jev-eye/issues"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/bismawy/pi-jev-eye/main/assets/banner.webp",
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
