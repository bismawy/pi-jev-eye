{
  "name": "@bismawy/pi-jev-eye",
  "version": "0.3.1",
  "type": "module",
  "description": "Ultra-lean supervisor. Three-layer guardrails. Semantic gate for Pi. Blocks destructive commands offline, checks tests, gates diffs through TypeSafe Jev, OpenRouter, or Cloudflare Workers AI (Clef), and reports Jev/Clef spend in /jev-eye usage.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "typesafe",
    "jev",
    "guardrail",
    "supervisor",
    "security",
    "clef",
    "cloudflare",
    "workers-ai",
    "clef-flash",
    "semantic-gate"
  ],
  "author": "bismawy",
  "license": "MIT",
  "scripts": {
    "dev": "pi -e ./extensions/index.ts",
    "test": "node --test",
    "render-check": "node --experimental-strip-types scripts/render-check.mjs",
    "typecheck": "npx -y -p typescript@7.0.2 tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bismawy/pi-jev-eye.git"
  },
  "homepage": "https://github.com/bismawy/pi-jev-eye#readme",
  "bugs": {
    "url": "https://github.com/bismawy/pi-jev-eye/issues"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/bismawy/pi-jev-eye/main/assets/banner.webp",
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
